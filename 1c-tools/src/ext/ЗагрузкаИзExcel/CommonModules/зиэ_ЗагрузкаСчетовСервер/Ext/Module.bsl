///////////////////////////////////////////////////////////////////////////////
// Загрузка счетов покупателям из Excel.
// Серверная логика: чтение файла, сопоставление колонок, разбор строк, создание документов.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание полей, которые можно загрузить из файла.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Имя, Представление, Обязательное, КлючевыеСлова (Массив строк).
//
Функция ОписаниеПолей() Экспорт

	Поля = Новый ТаблицаЗначений;
	Поля.Колонки.Добавить("Имя");
	Поля.Колонки.Добавить("Представление");
	Поля.Колонки.Добавить("Обязательное");
	Поля.Колонки.Добавить("КлючевыеСлова");

	ДобавитьПоле(Поля, "НомерСчета",       "Номер счёта",             Ложь,   "номер счет,№ счет,№счет,номер документа,номер заказа");
	ДобавитьПоле(Поля, "Дата",             "Дата счёта",              Ложь,   "дата счет,дата документа,дата");
	ДобавитьПоле(Поля, "ИНН",              "ИНН покупателя",          Истина, "инн");
	ДобавитьПоле(Поля, "Покупатель",       "Наименование покупателя", Ложь,   "покупатель,контрагент,клиент,заказчик,плательщик");
	ДобавитьПоле(Поля, "Артикул",          "Артикул",                 Ложь,   "артикул,код товара,sku");
	ДобавитьПоле(Поля, "Номенклатура",     "Товар / услуга",          Истина, "товар,услуг,номенклатура,наименование,позиция,работ");
	ДобавитьПоле(Поля, "Количество",       "Количество",              Истина, "кол-во,количество,кол.");
	ДобавитьПоле(Поля, "ЕдиницаИзмерения", "Единица измерения",       Ложь,   "ед. изм,ед.изм,единица,ед.");
	ДобавитьПоле(Поля, "Цена",             "Цена",                    Ложь,   "цена");
	ДобавитьПоле(Поля, "Сумма",            "Сумма",                   Ложь,   "сумма,стоимость");
	ДобавитьПоле(Поля, "СтавкаНДС",        "Ставка НДС",              Ложь,   "ставка ндс,ндс,ставка");
	ДобавитьПоле(Поля, "Комментарий",      "Комментарий",             Ложь,   "комментарий,примечание");

	Возврат Поля;

КонецФункции

// Читает файл Excel из временного хранилища.
//
// Параметры:
//   АдресФайла - Строка - адрес двоичных данных во временном хранилище.
//   ИмяФайла   - Строка - исходное имя файла (нужно расширение).
//
// Возвращаемое значение:
//   Массив - строки файла, каждая строка - Массив значений ячеек.
//
Функция ПрочитатьФайл(АдресФайла, ИмяФайла) Экспорт

	ЧастиИмени = СтрРазделить(ИмяФайла, ".");
	Расширение = НРег(ЧастиИмени[ЧастиИмени.ВГраница()]);
	Если Расширение <> "xlsx" И Расширение <> "xls" И Расширение <> "ods" Тогда
		ВызватьИсключение НСтр("ru = 'Поддерживаются файлы Excel (*.xlsx, *.xls) и *.ods'");
	КонецЕсли;

	// Платформа читает Excel только из файла, поэтому нужен временный файл.
	// Для этого у расширения должен быть снят флажок "Безопасный режим".
	Попытка
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяВременногоФайла);
	Исключение
		ВызватьИсключение НСтр("ru = 'Не удалось сохранить временный файл. Администратору: в списке расширений конфигурации
			|снимите флажок ""Безопасный режим"" у расширения ""ЗагрузкаИзExcel"".'") + Символы.ПС
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось прочитать файл: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьФайлы(ИмяВременногоФайла);

	Данные = Новый Массив;
	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		Строка = Новый Массив;
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			Область = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			Значение = Неопределено;
			Если Область.СодержитЗначение Тогда
				Значение = Область.Значение;
			КонецЕсли;
			Если Значение = Неопределено Или (ТипЗнч(Значение) = Тип("Строка") И Не ЗначениеЗаполнено(Значение)) Тогда
				Значение = СокрЛП(Область.Текст);
			КонецЕсли;
			Строка.Добавить(Значение);
		КонецЦикла;
		Данные.Добавить(Строка);
	КонецЦикла;

	Возврат Данные;

КонецФункции

// Ищет строку заголовка таблицы: первая строка, где заполнено не меньше трёх ячеек-строк.
//
// Возвращаемое значение:
//   Число - номер строки (с 1) или 0, если не найдена.
//
Функция НайтиСтрокуЗаголовка(Данные) Экспорт

	Для Индекс = 0 По Мин(Данные.ВГраница(), 29) Цикл
		Заполнено = 0;
		Для Каждого Значение Из Данные[Индекс] Цикл
			Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
				Заполнено = Заполнено + 1;
			КонецЕсли;
		КонецЦикла;
		Если Заполнено >= 3 Тогда
			Возврат Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Заголовки колонок из строки заголовка. Пустые заменяются на "Колонка N".
//
// Возвращаемое значение:
//   Массив - строки.
//
Функция ЗаголовкиКолонок(Данные, СтрокаЗаголовка) Экспорт

	Заголовки = Новый Массив;
	Если СтрокаЗаголовка < 1 Или СтрокаЗаголовка > Данные.Количество() Тогда
		Возврат Заголовки;
	КонецЕсли;

	Номер = 0;
	Для Каждого Значение Из Данные[СтрокаЗаголовка - 1] Цикл
		Номер = Номер + 1;
		Текст = СокрЛП(Строка(Значение));
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = СтрШаблон(НСтр("ru = 'Колонка %1'"), Номер);
		КонецЕсли;
		Заголовки.Добавить(Текст);
	КонецЦикла;

	Возврат Заголовки;

КонецФункции

// Сопоставляет поля загрузки с колонками файла.
// Сначала берёт сохранённую настройку пользователя, затем ищет по ключевым словам.
//
// Возвращаемое значение:
//   Соответствие - ключ: имя поля, значение: заголовок колонки ("" - не загружать).
//
Функция АвтоСопоставление(Заголовки) Экспорт

	Результат = Новый Соответствие;
	Занятые = Новый Соответствие;

	Сохраненное = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Сопоставление");
	Поля = ОписаниеПолей();

	Если ТипЗнч(Сохраненное) = Тип("Соответствие") Тогда
		Для Каждого Поле Из Поля Цикл
			Заголовок = Сохраненное.Получить(Поле.Имя);
			Если ЗначениеЗаполнено(Заголовок) И Заголовки.Найти(Заголовок) <> Неопределено
				И Занятые.Получить(Заголовок) = Неопределено Тогда
				Результат.Вставить(Поле.Имя, Заголовок);
				Занятые.Вставить(Заголовок, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Поле Из Поля Цикл
		Если Результат.Получить(Поле.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найден = "";
		Для Каждого Слово Из Поле.КлючевыеСлова Цикл
			Для Каждого Заголовок Из Заголовки Цикл
				Если Занятые.Получить(Заголовок) = Неопределено
					И СтрНайти(Нормализовать(Заголовок), Слово) > 0 Тогда
					Найден = Заголовок;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеЗаполнено(Найден) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить(Поле.Имя, Найден);
		Если ЗначениеЗаполнено(Найден) Тогда
			Занятые.Вставить(Найден, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сохраняет сопоставление колонок для текущего пользователя.
Процедура СохранитьСопоставление(Сопоставление) Экспорт
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Сопоставление", Сопоставление);
КонецПроцедуры

// Организация, выбранная при прошлой загрузке (или Неопределено).
Функция ПоследняяОрганизация() Экспорт
	Возврат ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Организация");
КонецФункции

Процедура СохранитьОрганизацию(Организация) Экспорт
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Организация", Организация);
КонецПроцедуры

// Новая пустая таблица разобранных строк (структура совпадает с реквизитом формы "Строки").
Функция НоваяТаблицаСтрок() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Загружать,НомерСтрокиФайла,КлючСчета,НомерСчета,Дата,ИНН,Покупатель,"
		+ "Артикул,Номенклатура,ЕдиницаИзмерения,Количество,Цена,Сумма,СтавкаНДС,Комментарий,Статус,Ошибка", ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Разбирает строки данных по сопоставлению и проверяет их.
//
// Параметры:
//   Данные          - Массив - результат ПрочитатьФайл.
//   СтрокаЗаголовка - Число.
//   Сопоставление   - Соответствие - имя поля -> заголовок колонки.
//   Организация     - СправочникСсылка.Организации.
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаСтрок.
//
Функция РазобратьСтроки(Данные, СтрокаЗаголовка, Сопоставление, Организация) Экспорт

	Результат = НоваяТаблицаСтрок();
	Заголовки = ЗаголовкиКолонок(Данные, СтрокаЗаголовка);

	ИндексыКолонок = Новый Соответствие;
	Для Каждого КлючИЗначение Из Сопоставление Цикл
		Индекс = Заголовки.Найти(КлючИЗначение.Значение);
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) И Индекс <> Неопределено Тогда
			ИндексыКолонок.Вставить(КлючИЗначение.Ключ, Индекс);
		КонецЕсли;
	КонецЦикла;

	НеСопоставлены = Новый Массив;
	Для Каждого Поле Из ОписаниеПолей() Цикл
		Если Поле.Обязательное И ИндексыКолонок.Получить(Поле.Имя) = Неопределено Тогда
			НеСопоставлены.Добавить(Поле.Представление);
		КонецЕсли;
	КонецЦикла;
	Если ИндексыКолонок.Получить("Цена") = Неопределено И ИндексыКолонок.Получить("Сумма") = Неопределено Тогда
		НеСопоставлены.Добавить(НСтр("ru = 'Цена или Сумма'"));
	КонецЕсли;
	Если НеСопоставлены.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Укажите колонки файла для полей: %1'"), СтрСоединить(НеСопоставлены, ", "));
	КонецЕсли;

	Для Индекс = СтрокаЗаголовка По Данные.ВГраница() Цикл

		Ячейки = Данные[Индекс];
		Если СтрокаПустая(Ячейки) Тогда
			Продолжить;
		КонецЕсли;

		Стр = Результат.Добавить();
		Стр.НомерСтрокиФайла = Индекс + 1;
		Ошибки = Новый Массив;

		Стр.НомерСчета       = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "НомерСчета")));
		Стр.Покупатель       = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "Покупатель")));
		Стр.Артикул          = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "Артикул")));
		Стр.Номенклатура     = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "Номенклатура")));
		Стр.ЕдиницаИзмерения = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "ЕдиницаИзмерения")));
		Стр.СтавкаНДС        = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "СтавкаНДС")));
		Стр.Комментарий      = СокрЛП(Строка(Ячейка(Ячейки, ИндексыКолонок, "Комментарий")));

		Стр.ИНН = ПривестиИНН(Ячейка(Ячейки, ИндексыКолонок, "ИНН"));
		Если Не ЗначениеЗаполнено(Стр.ИНН) Тогда
			Ошибки.Добавить(НСтр("ru = 'не указан ИНН'"));
		ИначеЕсли СтрДлина(Стр.ИНН) <> 10 И СтрДлина(Стр.ИНН) <> 12 Тогда
			Ошибки.Добавить(НСтр("ru = 'ИНН должен содержать 10 или 12 цифр'"));
		КонецЕсли;

		ЗначениеДаты = Ячейка(Ячейки, ИндексыКолонок, "Дата");
		Стр.Дата = ПривестиДату(ЗначениеДаты);
		Если ЗначениеЗаполнено(ЗначениеДаты) И Не ЗначениеЗаполнено(Стр.Дата) Тогда
			Ошибки.Добавить(НСтр("ru = 'не распознана дата'"));
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			Ошибки.Добавить(НСтр("ru = 'не указан товар/услуга'"));
		КонецЕсли;

		Стр.Количество = ПривестиЧисло(Ячейка(Ячейки, ИндексыКолонок, "Количество"));
		Цена  = ПривестиЧисло(Ячейка(Ячейки, ИндексыКолонок, "Цена"));
		Сумма = ПривестиЧисло(Ячейка(Ячейки, ИндексыКолонок, "Сумма"));
		Если Не ЗначениеЗаполнено(Стр.Количество) Или Стр.Количество <= 0 Тогда
			Ошибки.Добавить(НСтр("ru = 'количество должно быть больше 0'"));
		Иначе
			Если Не ЗначениеЗаполнено(Цена) И ЗначениеЗаполнено(Сумма) Тогда
				Цена = Сумма / Стр.Количество;
			КонецЕсли;
			Если ЗначениеЗаполнено(Цена) Тогда
				Стр.Цена  = Окр(Цена, 2);
				Стр.Сумма = Окр(Стр.Цена * Стр.Количество, 2);
			Иначе
				Ошибки.Добавить(НСтр("ru = 'не указана цена'"));
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Стр.СтавкаНДС) И СтавкаНДСИзТекста(Стр.СтавкаНДС) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'неизвестная ставка НДС ""%1""'"), Стр.СтавкаНДС));
		КонецЕсли;

		Стр.КлючСчета = ?(ЗначениеЗаполнено(Стр.НомерСчета), "№" + Стр.НомерСчета,
			Стр.ИНН + "|" + Формат(Стр.Дата, "ДФ=yyyyMMdd"));

		Стр.Ошибка = Ошибки.Количество() > 0;
		Стр.Загружать = Не Стр.Ошибка;
		Если Стр.Ошибка Тогда
			Стр.Статус = НСтр("ru = 'Ошибка: '") + СтрСоединить(Ошибки, "; ");
		КонецЕсли;

	КонецЦикла;

	ЗаполнитьСтатусы(Результат, Организация);

	Возврат Результат;

КонецФункции

// Создаёт счета покупателям по отмеченным строкам без ошибок.
// Строки с одинаковым КлючСчета попадают в один документ. Каждый счёт создаётся в своей транзакции.
//
// Параметры:
//   Строки                  - ТаблицаЗначений - см. НоваяТаблицаСтрок.
//   Организация             - СправочникСсылка.Организации.
//   Проводить               - Булево.
//   НоваяНоменклатураУслуга - Булево - создавать новую номенклатуру как услугу.
//
// Возвращаемое значение:
//   Структура - Созданные (Массив ДокументСсылка), Ошибки (Массив строк).
//
Функция СоздатьСчета(Строки, Организация, Проводить, НоваяНоменклатураУслуга) Экспорт

	Результат = Новый Структура("Созданные, Ошибки", Новый Массив, Новый Массив);

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите организацию'");
	КонецЕсли;

	Ключи = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Если Стр.Загружать = Истина И Не Стр.Ошибка И Ключи.Найти(Стр.КлючСчета) = Неопределено Тогда
			Ключи.Добавить(Стр.КлючСчета);
		КонецЕсли;
	КонецЦикла;

	Кэш = Новый Структура("Контрагенты, Номенклатура", Новый Соответствие, Новый Соответствие);

	Для Каждого Ключ Из Ключи Цикл

		СтрокиСчета = Новый Массив;
		Для Каждого Стр Из Строки.НайтиСтроки(Новый Структура("КлючСчета", Ключ)) Цикл
			Если Стр.Загружать = Истина И Не Стр.Ошибка Тогда
				СтрокиСчета.Добавить(Стр);
			КонецЕсли;
		КонецЦикла;

		СозданоВТранзакции = Новый Массив;
		НачатьТранзакцию();
		Попытка
			Документ = СоздатьСчет(СтрокиСчета, Организация, Проводить, НоваяНоменклатураУслуга, Кэш, СозданоВТранзакции);
			ЗафиксироватьТранзакцию();
			Результат.Созданные.Добавить(Документ);
			Для Каждого Стр Из СтрокиСчета Цикл
				Стр.Статус = СтрШаблон(НСтр("ru = 'Загружено: %1'"), Документ);
				Стр.Загружать = Ложь;
			КонецЦикла;
		Исключение
			ОтменитьТранзакцию();
			// Созданные в отменённой транзакции элементы справочников не существуют - убираем их из кэша.
			Для Каждого Элемент Из СозданоВТранзакции Цикл
				Кэш[Элемент.Вид].Удалить(Элемент.Ключ);
			КонецЦикла;
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Счёт %1 (строки %2): %3'"),
				СтрокиСчета[0].НомерСчета, НомераСтрок(СтрокиСчета), ТекстОшибки));
			Для Каждого Стр Из СтрокиСчета Цикл
				Стр.Статус = НСтр("ru = 'Ошибка записи: '") + ТекстОшибки;
			КонецЦикла;
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка счетов из Excel'"), УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПоле(Поля, Имя, Представление, Обязательное, КлючевыеСлова)
	Поле = Поля.Добавить();
	Поле.Имя = Имя;
	Поле.Представление = Представление;
	Поле.Обязательное = Обязательное;
	Поле.КлючевыеСлова = СтрРазделить(КлючевыеСлова, ",", Ложь);
КонецПроцедуры

Функция КлючНастроек()
	Возврат "зиэ_ЗагрузкаСчетовПокупателямИзExcel";
КонецФункции

Функция Нормализовать(Текст)
	Возврат СтрЗаменить(НРег(СокрЛП(Текст)), "ё", "е");
КонецФункции

Функция СтрокаПустая(Ячейки)
	Для Каждого Значение Из Ячейки Цикл
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция Ячейка(Ячейки, ИндексыКолонок, ИмяПоля)
	Индекс = ИндексыКолонок.Получить(ИмяПоля);
	Если Индекс = Неопределено Или Индекс > Ячейки.ВГраница() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ячейки[Индекс];
КонецФункции

Функция ПривестиЧисло(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = НРег(СокрЛП(Строка(Значение)));
	Для Каждого Лишнее Из СтрРазделить("руб.|руб|р.|₽|шт", "|") Цикл
		Текст = СтрЗаменить(Текст, Лишнее, "");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ПривестиДату(Значение)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	// Excel хранит дату как число дней от 30.12.1899 (дробная часть - время).
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение >= 1 И Значение < 2958466 Тогда
			Возврат Дата(1899, 12, 30) + Цел(Значение) * 86400;
		КонецЕсли;
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = СтрРазделить(Текст, " ")[0];
	Части = СтрРазделить(СтрЗаменить(СтрЗаменить(Текст, "/", "."), "-", "."), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Если СтрДлина(Части[0]) = 4 Тогда // ГГГГ-ММ-ДД
			Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
		КонецЕсли;
		Год = Число(Части[2]);
		Если Год < 100 Тогда
			Год = 2000 + Год;
		КонецЕсли;
		Возврат Дата(Год, Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

Функция ПривестиИНН(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = Формат(Значение, "ЧГ=0");
	Иначе
		Текст = СокрЛП(Строка(Значение));
	КонецЕсли;
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;
КонецФункции

// Возвращает ПеречислениеСсылка.СтавкиНДС или Неопределено.
Функция СтавкаНДСИзТекста(Текст)
	Нормализованный = Нормализовать(Текст);
	Если Не ЗначениеЗаполнено(Нормализованный) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрНайти(Нормализованный, "без") > 0 Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	Цифры = ПривестиИНН(Нормализованный); // оставить только цифры
	Если Не ЗначениеЗаполнено(Цифры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Найти("НДС" + Цифры) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС["НДС" + Цифры];
КонецФункции

Функция НомераСтрок(СтрокиСчета)
	Номера = Новый Массив;
	Для Каждого Стр Из СтрокиСчета Цикл
		Номера.Добавить(Формат(Стр.НомерСтрокиФайла, "ЧГ=0"));
	КонецЦикла;
	Возврат СтрСоединить(Номера, ", ");
КонецФункции

Функция МеткаСчета(НомерСчета)
	Возврат "[Excel " + НомерСчета + "]";
КонецФункции

// Заполняет статусы строк без ошибок: что будет создано, что уже загружено ранее.
Процедура ЗаполнитьСтатусы(Таблица, Организация)

	ИНН = Новый Массив;
	Наименования = Новый Массив;
	Номера = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Если Стр.Ошибка Тогда
			Продолжить;
		КонецЕсли;
		ИНН.Добавить(Стр.ИНН);
		Наименования.Добавить(Стр.Номенклатура);
		Если ЗначениеЗаполнено(Стр.НомерСчета) Тогда
			Номера.Добавить(МеткаСчета(Стр.НомерСчета));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН В(&ИНН)
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование В(&Наименования)
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Комментарий КАК Комментарий,
	|	Счета.Контрагент.ИНН КАК ИНН
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	НЕ Счета.ПометкаУдаления
	|	И Счета.Организация = &Организация
	|	И Счета.Комментарий ПОДОБНО ""%~[Excel %"" СПЕЦСИМВОЛ ""~""";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("Наименования", Наименования);
	Запрос.УстановитьПараметр("Организация", Организация);
	Пакет = Запрос.ВыполнитьПакет();

	ЕстьИНН = Новый Соответствие;
	Для Каждого Строка Из Пакет[0].Выгрузить() Цикл
		ЕстьИНН.Вставить(Строка.ИНН, Истина);
	КонецЦикла;
	ЕстьНоменклатура = Новый Соответствие;
	Для Каждого Строка Из Пакет[1].Выгрузить() Цикл
		ЕстьНоменклатура.Вставить(НРег(Строка.Наименование), Истина);
	КонецЦикла;
	РанееЗагруженные = Пакет[2].Выгрузить();

	Для Каждого Стр Из Таблица Цикл
		Если Стр.Ошибка Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Стр.НомерСчета) Тогда
			Метка = МеткаСчета(Стр.НомерСчета);
			Для Каждого Загруженный Из РанееЗагруженные Цикл
				Если СтрНайти(Загруженный.Комментарий, Метка) > 0 И Загруженный.ИНН = Стр.ИНН Тогда
					Стр.Статус = СтрШаблон(НСтр("ru = 'Уже загружен: %1'"), Загруженный.Ссылка);
					Стр.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеЗаполнено(Стр.Статус) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Примечания = Новый Массив;
		Если ЕстьИНН.Получить(Стр.ИНН) = Неопределено Тогда
			Примечания.Добавить(НСтр("ru = 'новый контрагент'"));
		КонецЕсли;
		Если ЕстьНоменклатура.Получить(НРег(Стр.Номенклатура)) = Неопределено Тогда
			Примечания.Добавить(НСтр("ru = 'новая номенклатура'"));
		КонецЕсли;
		Стр.Статус = ?(Примечания.Количество() = 0, НСтр("ru = 'Готово к загрузке'"),
			НСтр("ru = 'Будет создано: '") + СтрСоединить(Примечания, ", "));
	КонецЦикла;

КонецПроцедуры

Функция СоздатьСчет(СтрокиСчета, Организация, Проводить, НоваяНоменклатураУслуга, Кэш, СозданоВТранзакции)

	Первая = СтрокиСчета[0];
	Контрагент = НайтиИлиСоздатьКонтрагента(Первая.ИНН, Первая.Покупатель, Кэш, СозданоВТранзакции);

	Документ = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	Документ.Дата = ?(ЗначениеЗаполнено(Первая.Дата), НачалоДня(Первая.Дата) + (ТекущаяДатаСеанса() - НачалоДня(ТекущаяДатаСеанса())),
		ТекущаяДатаСеанса());
	Документ.Заполнить(Новый Структура("Организация, Контрагент", Организация, Контрагент));
	Документ.Организация = Организация;
	Документ.Контрагент = Контрагент;
	Если Не ЗначениеЗаполнено(Документ.ВидОперации) Тогда
		Документ.ВидОперации = Перечисления.ВидыОперацийСчетаПокупателю.ТоварыИУслуги;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
		Документ.ДоговорКонтрагента = ДоговорПокупателя(Организация, Контрагент);
	КонецЕсли;

	Комментарии = Новый Массив;
	Если ЗначениеЗаполнено(Первая.НомерСчета) Тогда
		Комментарии.Добавить(МеткаСчета(Первая.НомерСчета));
	Иначе
		Комментарии.Добавить("[Excel]");
	КонецЕсли;
	Для Каждого Стр Из СтрокиСчета Цикл
		Если ЗначениеЗаполнено(Стр.Комментарий) И Комментарии.Найти(Стр.Комментарий) = Неопределено Тогда
			Комментарии.Добавить(Стр.Комментарий);
		КонецЕсли;
	КонецЦикла;
	Документ.Комментарий = СтрСоединить(Комментарии, " ");

	Для Каждого Стр Из СтрокиСчета Цикл

		Номенклатура = НайтиИлиСоздатьНоменклатуру(Стр, НоваяНоменклатураУслуга, Кэш, СозданоВТранзакции);

		СтрокаТовара = Документ.Товары.Добавить();
		СтрокаТовара.Номенклатура = Номенклатура;
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Услуга") = Истина Тогда
			СтрокаТовара.Содержание = Стр.Номенклатура;
		КонецЕсли;
		СтрокаТовара.Количество = Стр.Количество;
		СтрокаТовара.Цена = Стр.Цена;
		СтрокаТовара.Сумма = Стр.Сумма;

		Если Документ.ДокументБезНДС Тогда
			СтрокаТовара.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		ИначеЕсли ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
			СтрокаТовара.СтавкаНДС = СтавкаНДСИзТекста(Стр.СтавкаНДС);
		Иначе
			СтрокаТовара.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		КонецЕсли;
		СтрокаТовара.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(СтрокаТовара.Сумма, Документ.СуммаВключаетНДС,
			УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаТовара.СтавкаНДС));

	КонецЦикла;

	Документ.СуммаДокумента = УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(Документ);
	Документ.Записать(?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));

	Возврат Документ.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьКонтрагента(ИНН, Наименование, Кэш, СозданоВТранзакции)

	Найденный = Кэш.Контрагенты.Получить(ИНН);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Наименование");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Найденный = Выборка.Ссылка;
	Иначе
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Заполнить(Неопределено);
		Имя = ?(ЗначениеЗаполнено(Наименование), Наименование, СтрШаблон(НСтр("ru = 'Покупатель ИНН %1'"), ИНН));
		Объект.Наименование = Имя;
		Объект.НаименованиеПолное = Имя;
		Объект.ИНН = ИНН;
		Объект.ЮридическоеФизическоеЛицо = ?(СтрДлина(ИНН) = 12,
			Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо, Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
		Объект.Комментарий = НСтр("ru = 'Создан при загрузке счетов из Excel'");
		Объект.Записать();
		Найденный = Объект.Ссылка;
		СозданоВТранзакции.Добавить(Новый Структура("Вид, Ключ", "Контрагенты", ИНН));
	КонецЕсли;

	Кэш.Контрагенты.Вставить(ИНН, Найденный);
	Возврат Найденный;

КонецФункции

Функция НайтиИлиСоздатьНоменклатуру(Стр, НоваяНоменклатураУслуга, Кэш, СозданоВТранзакции)

	Ключ = НРег(Стр.Артикул) + "|" + НРег(Стр.Номенклатура);
	Найденный = Кэш.Номенклатура.Получить(Ключ);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И (&Артикул <> """" И Номенклатура.Артикул = &Артикул
	|		ИЛИ Номенклатура.Наименование = &Наименование)
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА &Артикул <> """" И Номенклатура.Артикул = &Артикул
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ");
	Запрос.УстановитьПараметр("Артикул", Стр.Артикул);
	Запрос.УстановитьПараметр("Наименование", Стр.Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Найденный = Выборка.Ссылка;
	Иначе
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Заполнить(Неопределено);
		Объект.Наименование = Лев(Стр.Номенклатура, 100);
		Объект.НаименованиеПолное = Стр.Номенклатура;
		Объект.Артикул = Стр.Артикул;
		Объект.Услуга = НоваяНоменклатураУслуга;
		ВидНоменклатуры = ВидНоменклатуры(НоваяНоменклатураУслуга);
		Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
			Объект.ВидНоменклатуры = ВидНоменклатуры;
		КонецЕсли;
		Единица = ЕдиницаИзмерения(Стр.ЕдиницаИзмерения);
		Если ЗначениеЗаполнено(Единица) Тогда
			Объект.ЕдиницаИзмерения = Единица;
		КонецЕсли;
		Объект.Комментарий = НСтр("ru = 'Создана при загрузке счетов из Excel'");
		Объект.Записать();
		Найденный = Объект.Ссылка;
		СозданоВТранзакции.Добавить(Новый Структура("Вид, Ключ", "Номенклатура", Ключ));
	КонецЕсли;

	Кэш.Номенклатура.Вставить(Ключ, Найденный);
	Возврат Найденный;

КонецФункции

Функция ВидНоменклатуры(Услуга)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|ГДЕ
	|	Виды.Услуга = &Услуга
	|	И НЕ Виды.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Виды.Предопределенный УБЫВ,
	|	Виды.Наименование");
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ЕдиницаИзмерения(Наименование)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Единицы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК Единицы
	|ГДЕ
	|	НЕ Единицы.ПометкаУдаления
	|	И (Единицы.Наименование = &Наименование
	|		ИЛИ Единицы.Код = ""796"")
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Единицы.Наименование = &Наименование
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ");
	Запрос.УстановитьПараметр("Наименование", СокрЛП(СтрЗаменить(Наименование, ".", "")));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ДоговорПокупателя(Организация, Контрагент)

	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ВидыДоговоров = Новый Массив;
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(Договор, Контрагент, Организация, ВидыДоговоров);
	Если ЗначениеЗаполнено(Договор) Тогда
		Возврат Договор;
	КонецЕсли;

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Владелец = Контрагент;
	Объект.Организация = Организация;
	Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Объект.Наименование = НСтр("ru = 'Основной договор'");
	Если Не ЗначениеЗаполнено(Объект.ВалютаВзаиморасчетов) Тогда
		Объект.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти
