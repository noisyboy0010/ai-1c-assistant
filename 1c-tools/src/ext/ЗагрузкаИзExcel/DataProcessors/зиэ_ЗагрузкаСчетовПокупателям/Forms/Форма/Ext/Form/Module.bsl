#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = НСтр("ru = 'Загрузка счетов покупателям из Excel'");
	ЗаполнитьСписокОрганизаций();

	НоваяНоменклатураУслуга = Истина;
	Проводить = Ложь;

	Для Каждого Поле Из зиэ_ЗагрузкаСчетовСервер.ОписаниеПолей() Цикл
		Строка = Сопоставление.Добавить();
		Строка.Поле = Поле.Имя;
		Строка.Представление = Поле.Представление;
		Строка.Обязательное = Поле.Обязательное;
	КонецЦикла;
	Элементы.СопоставлениеКолонка.СписокВыбора.Добавить("", НСтр("ru = '<не загружать>'"));

	НастроитьОформление();
	ОбновитьИтог(НСтр("ru = 'Выберите файл Excel со счетами покупателям.'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файл со счетами'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Файлы Excel (*.xlsx;*.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*'");

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = ОписаниеФайла.Адрес;
	ИмяФайла = ОписаниеФайла.СсылкаНаФайл.Имя;
	ПрочитатьФайлНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура СтрокаЗаголовкаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ПрименитьЗаголовкиНаСервере(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	РазобратьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблиц

&НаКлиенте
Процедура СопоставлениеКолонкаПриИзменении(Элемент)

	РазобратьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтрокиЗагружатьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Ошибка Тогда
		ТекущиеДанные.Загружать = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Строку с ошибкой загрузить нельзя: исправьте файл и перечитайте его.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СозданныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Созданные.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перечитать(Команда)

	Если ЗначениеЗаполнено(АдресФайла) Тогда
		ПрочитатьФайлНаКлиенте();
	Иначе
		ИмяФайлаНачалоВыбора(Элементы.ИмяФайла, Неопределено, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	КоличествоСчетов = КоличествоСчетовКЗагрузке();
	Если КоличествоСчетов = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк для загрузки: выберите файл и отметьте строки без ошибок.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите организацию.'"));
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Будет создано счетов: %1. Продолжить?'"), КоличествоСчетов);
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗагрузитьНаСервере();

	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	КонецЦикла;

	Если Результат.Создано > 0 Тогда
		ОповеститьОбИзменении(Тип("ДокументСсылка.СчетНаОплатуПокупателю"));
		Оповестить("Запись_СчетНаОплатуПокупателю");
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Загрузка счетов из Excel'"), ,
		СтрШаблон(НСтр("ru = 'Создано счетов: %1, ошибок: %2'"), Результат.Создано, Результат.Ошибки.Количество()),
		БиблиотекаКартинок.Информация32);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрочитатьФайлНаКлиенте()

	ТекстОшибки = ПрочитатьФайлНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПрочитатьФайлНаСервере()

	Попытка
		Данные = зиэ_ЗагрузкаСчетовСервер.ПрочитатьФайл(АдресФайла, ИмяФайла);
	Исключение
		Строки.Очистить();
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбновитьИтог(ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	АдресДанных = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	СтрокаЗаголовка = зиэ_ЗагрузкаСчетовСервер.НайтиСтрокуЗаголовка(Данные);
	Если СтрокаЗаголовка = 0 Тогда
		Строки.Очистить();
		ТекстОшибки = НСтр("ru = 'Не найдена строка с заголовками колонок. Укажите её номер вручную.'");
		ОбновитьИтог(ТекстОшибки);
		Возврат ТекстОшибки;
	КонецЕсли;

	ПрименитьЗаголовки(Данные, Истина);
	Возврат "";

КонецФункции

&НаСервере
Процедура ПрименитьЗаголовкиНаСервере(Авто)

	ПрименитьЗаголовки(ПолучитьИзВременногоХранилища(АдресДанных), Авто);

КонецПроцедуры

&НаСервере
Процедура ПрименитьЗаголовки(Данные, Авто)

	Заголовки = зиэ_ЗагрузкаСчетовСервер.ЗаголовкиКолонок(Данные, СтрокаЗаголовка);

	СписокКолонок = Элементы.СопоставлениеКолонка.СписокВыбора;
	СписокКолонок.Очистить();
	СписокКолонок.Добавить("", НСтр("ru = '<не загружать>'"));
	Для Каждого Заголовок Из Заголовки Цикл
		СписокКолонок.Добавить(Заголовок, Заголовок);
	КонецЦикла;

	Если Авто Тогда
		Найденные = зиэ_ЗагрузкаСчетовСервер.АвтоСопоставление(Заголовки);
		Для Каждого Строка Из Сопоставление Цикл
			Значение = Найденные.Получить(Строка.Поле);
			Строка.Колонка = ?(Значение = Неопределено, "", Значение);
		КонецЦикла;
	Иначе
		Для Каждого Строка Из Сопоставление Цикл
			Если Заголовки.Найти(Строка.Колонка) = Неопределено Тогда
				Строка.Колонка = "";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	РазобратьНаСервере(Данные);

КонецПроцедуры

&НаСервере
Процедура РазобратьНаСервере(Знач Данные = Неопределено)

	Если Данные = Неопределено Тогда
		Если Не ЗначениеЗаполнено(АдресДанных) Тогда
			Возврат;
		КонецЕсли;
		Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;

	Строки.Очистить();
	Попытка
		Таблица = зиэ_ЗагрузкаСчетовСервер.РазобратьСтроки(Данные, СтрокаЗаголовка,
			СопоставлениеИзТаблицы(), Организация);
	Исключение
		ОбновитьИтог(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(Таблица, "Строки");
	ОбновитьИтог();

КонецПроцедуры

&НаСервере
Функция ЗагрузитьНаСервере()

	Таблица = РеквизитФормыВЗначение("Строки");
	Результат = зиэ_ЗагрузкаСчетовСервер.СоздатьСчета(Таблица, Организация, Проводить, НоваяНоменклатураУслуга);
	ЗначениеВРеквизитФормы(Таблица, "Строки");

	Для Каждого Документ Из Результат.Созданные Цикл
		Созданные.Добавить().Документ = Документ;
	КонецЦикла;

	зиэ_ЗагрузкаСчетовСервер.СохранитьСопоставление(СопоставлениеИзТаблицы());
	зиэ_ЗагрузкаСчетовСервер.СохранитьОрганизацию(Организация);
	ОбновитьИтог();

	Возврат Новый Структура("Создано, Ошибки", Результат.Созданные.Количество(), Результат.Ошибки);

КонецФункции

&НаСервере
Функция СопоставлениеИзТаблицы()

	Результат = Новый Соответствие;
	Для Каждого Строка Из Сопоставление Цикл
		Результат.Вставить(Строка.Поле, Строка.Колонка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция КоличествоСчетовКЗагрузке()

	Ключи = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Загружать И Не Строка.Ошибка Тогда
			Ключи.Вставить(Строка.КлючСчета, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Ключи.Количество();

КонецФункции

&НаСервере
Процедура ОбновитьИтог(ТекстСообщения = "")

	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ИтогИнфо = ТекстСообщения;
		Возврат;
	КонецЕсли;

	КЗагрузке = 0;
	СОшибками = 0;
	Ключи = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Ошибка Тогда
			СОшибками = СОшибками + 1;
		ИначеЕсли Строка.Загружать Тогда
			КЗагрузке = КЗагрузке + 1;
			Ключи.Вставить(Строка.КлючСчета, Истина);
		КонецЕсли;
	КонецЦикла;

	ИтогИнфо = СтрШаблон(НСтр("ru = 'Строк в файле: %1. К загрузке: %2 (счетов: %3). С ошибками: %4.'"),
		Строки.Количество(), КЗагрузке, Ключи.Количество(), СОшибками);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОрганизаций()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Организация.СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	Последняя = зиэ_ЗагрузкаСчетовСервер.ПоследняяОрганизация();
	Если ЗначениеЗаполнено(Последняя) И Элементы.Организация.СписокВыбора.НайтиПоЗначению(Последняя) <> Неопределено Тогда
		Организация = Последняя;
	Иначе
		Организация = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) И Элементы.Организация.СписокВыбора.Количество() > 0 Тогда
		Организация = Элементы.Организация.СписокВыбора[0].Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Строки.Ошибка");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	ПолеОформления = Элемент.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("СтрокиСтатус");

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Строки.Загружать");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	ПолеОформления = Элемент.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Строки");

КонецПроцедуры

#КонецОбласти
