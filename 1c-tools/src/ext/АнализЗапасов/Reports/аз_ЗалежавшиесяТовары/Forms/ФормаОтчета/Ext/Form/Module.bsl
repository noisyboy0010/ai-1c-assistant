#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры_ = аз_ЗалежавшиесяТоварыСервер.НовыеПараметры();
	Дата = Параметры_.Дата;
	ПорогДней = Параметры_.ПорогДней;
	Сортировка = Параметры_.Сортировка;
	ПоказыватьОтрицательные = Параметры_.ПоказыватьОтрицательные;
	Организация = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");

	Элементы.Сортировка.СписокВыбора.Добавить("ПоСумме", "по сумме");
	Элементы.Сортировка.СписокВыбора.Добавить("ПоДням", "по дням без продаж");
	Элементы.ГруппаНоменклатуры.ВыборГруппИЭлементов = ГруппыИЭлементы.Группы;

	СформироватьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	Настройки = аз_ЗалежавшиесяТоварыСервер.НовыеПараметры();
	Настройки.Дата = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Настройки.Организация = Организация;
	Настройки.ГруппаНоменклатуры = ГруппаНоменклатуры;
	Настройки.ПорогДней = ПорогДней;
	Настройки.Сортировка = Сортировка;
	Настройки.ПоказыватьОтрицательные = ПоказыватьОтрицательные;
	Результат = аз_ЗалежавшиесяТоварыСервер.СформироватьОтчет(Настройки);

КонецПроцедуры

#КонецОбласти
