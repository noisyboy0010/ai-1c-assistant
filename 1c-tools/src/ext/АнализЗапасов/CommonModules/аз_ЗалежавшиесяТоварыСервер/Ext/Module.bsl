// Отчёт «Залежавшиеся товары»: остатки на счёте 41 и сколько дней каждая позиция лежит без продаж.
// «Продажа» (расход) — любое списание с 41 не на 41 (реализация, розница, списание, возврат поставщику).
// «Поступление» — любой приход на 41 не с 41. Перемещения между субсчетами 41 не учитываются.

#Область ПрограммныйИнтерфейс

// Параметры отчёта по умолчанию.
Функция НовыеПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Дата", ТекущаяДатаСеанса());
	Параметры.Вставить("Организация", Неопределено);
	Параметры.Вставить("ГруппаНоменклатуры", Неопределено);
	Параметры.Вставить("ПорогДней", 90);
	Параметры.Вставить("Сортировка", "ПоСумме"); // ПоСумме | ПоДням
	Параметры.Вставить("ПоказыватьОтрицательные", Истина);
	Возврат Параметры;

КонецФункции

// Таблица по каждой позиции с ненулевым остатком.
// Колонки: Организация, Номенклатура, Артикул, ЕдиницаИзмерения, Количество, Сумма,
//          ПоследнийПриход, ПоследнийРасход, ДнейБезПродаж (Неопределено — движений нет), Срок, ИндексСрока.
Функция ДанныеОтчета(Знач Параметры) Экспорт

	Параметры = ДополнитьПараметры(Параметры);
	ДатаОтчета = КонецДня(Параметры.Дата);

	Запрос = Новый Запрос(ТекстЗапроса());
	Запрос.УстановитьПараметр("СчетТовары", ПланыСчетов.Хозрасчетный.Товары);
	Запрос.УстановитьПараметр("КонецПериода", ДатаОтчета);
	Запрос.УстановитьПараметр("Граница", Новый Граница(ДатаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Параметры.Организация));
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("ВсяНоменклатура", Не ЗначениеЗаполнено(Параметры.ГруппаНоменклатуры));
	Запрос.УстановитьПараметр("Группа", Параметры.ГруппаНоменклатуры);

	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("ДнейБезПродаж");
	Таблица.Колонки.Добавить("Срок", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИндексСрока", Новый ОписаниеТипов("Число"));

	ПустаяДата = Дата(1, 1, 1);
	Для Каждого Строка Из Таблица Цикл
		ДатаОтсчета = ?(Строка.ПоследнийРасход > ПустаяДата, Строка.ПоследнийРасход, Строка.ПоследнийПриход);
		Если ДатаОтсчета > ПустаяДата Тогда
			Строка.ДнейБезПродаж = Макс(0, Цел((НачалоДня(ДатаОтчета) - НачалоДня(ДатаОтсчета)) / 86400));
		КонецЕсли;
		Строка.ИндексСрока = ИндексСрока(Строка.ДнейБезПродаж);
		Строка.Срок = Сроки()[Строка.ИндексСрока].Имя;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Готовый табличный документ отчёта.
Функция СформироватьОтчет(Знач Параметры) Экспорт

	Параметры = ДополнитьПараметры(Параметры);
	Данные = ДанныеОтчета(Параметры);

	Положительные = Данные.СкопироватьКолонки();
	Отрицательные = Данные.СкопироватьКолонки();
	Для Каждого Строка Из Данные Цикл
		Если Строка.Количество > 0 Тогда
			ЗаполнитьЗначенияСвойств(Положительные.Добавить(), Строка);
		ИначеЕсли Строка.Количество < 0 Тогда
			ЗаполнитьЗначенияСвойств(Отрицательные.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	ВсегоСумма = Положительные.Итог("Сумма");
	НесколькоОрганизаций = Не ЗначениеЗаполнено(Параметры.Организация);

	ТД = Новый ТабличныйДокумент;
	ТД.КлючПараметровПечати = "аз_ЗалежавшиесяТовары";
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТД.АвтоМасштаб = Истина;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.ТолькоПросмотр = Истина;

	Стр = 1;
	ВывестиТекст(ТД, Стр, 2, "Залежавшиеся товары на " + Формат(Параметры.Дата, "ДЛФ=D"), 14, Истина);
	Стр = Стр + 1;
	Отборы = Новый Массив;
	Отборы.Добавить("Организация: " + ?(НесколькоОрганизаций, "все", Строка(Параметры.Организация)));
	Если ЗначениеЗаполнено(Параметры.ГруппаНоменклатуры) Тогда
		Отборы.Добавить("Группа: " + Строка(Параметры.ГруппаНоменклатуры));
	КонецЕсли;
	Отборы.Добавить("без продаж от " + Формат(Параметры.ПорогДней, "ЧН=0; ЧГ=") + " дн.");
	ВывестиТекст(ТД, Стр, 2, СтрСоединить(Отборы, "; "), 9, Ложь, ЦветСерый());
	Стр = Стр + 2;

	// ---------- Сводка по срокам ----------
	ВывестиТекст(ТД, Стр, 2, "Сводка: сколько лежит без продаж", 11, Истина);
	Стр = Стр + 1;
	ВывестиШапку(ТД, Стр, 2, СтрРазделить("Срок без продаж|Позиций|Сумма, руб.|Доля, %", "|"));
	Стр = Стр + 1;
	Для Каждого Срок Из Сроки() Цикл
		Отбор = Положительные.НайтиСтроки(Новый Структура("ИндексСрока", Срок.Индекс));
		Если Отбор.Количество() = 0 И Срок.Индекс = 0 Тогда
			Продолжить; // «движений нет» показываем, только если такие есть
		КонецЕсли;
		СуммаСрока = 0;
		Для Каждого Строка Из Отбор Цикл
			СуммаСрока = СуммаСрока + Строка.Сумма;
		КонецЦикла;
		ВывестиЯчейку(ТД, Стр, 2, Срок.Имя, , Срок.Цвет);
		ВывестиЯчейку(ТД, Стр, 3, Отбор.Количество(), "ЧН=0; ЧГ=");
		ВывестиЯчейку(ТД, Стр, 4, СуммаСрока, "ЧДЦ=2; ЧН=0,00");
		ВывестиЯчейку(ТД, Стр, 5, Доля(СуммаСрока, ВсегоСумма), "ЧДЦ=1; ЧН=0,0");
		Стр = Стр + 1;
	КонецЦикла;
	ВывестиЯчейку(ТД, Стр, 2, "Итого запас", , , Истина);
	ВывестиЯчейку(ТД, Стр, 3, Положительные.Количество(), "ЧН=0; ЧГ=", , Истина);
	ВывестиЯчейку(ТД, Стр, 4, ВсегоСумма, "ЧДЦ=2; ЧН=0,00", , Истина);
	ВывестиЯчейку(ТД, Стр, 5, ?(ВсегоСумма = 0, 0, 100), "ЧДЦ=1; ЧН=0,0", , Истина);
	Стр = Стр + 2;

	// ---------- Список залежавшихся ----------
	Залежавшиеся = Положительные.СкопироватьКолонки();
	Для Каждого Строка Из Положительные Цикл
		Если Строка.ДнейБезПродаж = Неопределено Или Строка.ДнейБезПродаж >= Параметры.ПорогДней Тогда
			ЗаполнитьЗначенияСвойств(Залежавшиеся.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	Залежавшиеся.Колонки.Добавить("ДнейДляСортировки", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Залежавшиеся Цикл
		Строка.ДнейДляСортировки = ?(Строка.ДнейБезПродаж = Неопределено, 999999, Строка.ДнейБезПродаж);
	КонецЦикла;
	Если Параметры.Сортировка = "ПоДням" Тогда
		Залежавшиеся.Сортировать("ДнейДляСортировки Убыв, Сумма Убыв");
	Иначе
		Залежавшиеся.Сортировать("Сумма Убыв, ДнейДляСортировки Убыв");
	КонецЕсли;

	СуммаЗалежавшихся = Залежавшиеся.Итог("Сумма");
	ВывестиТекст(ТД, Стр, 2, СтрШаблон("Без продаж %1 дн. и дольше: %2 поз. на %3 руб. (%4%% запаса)",
		Формат(Параметры.ПорогДней, "ЧН=0; ЧГ="), Залежавшиеся.Количество(),
		Формат(СуммаЗалежавшихся, "ЧДЦ=2; ЧН=0,00"), Формат(Доля(СуммаЗалежавшихся, ВсегоСумма), "ЧДЦ=1; ЧН=0")), 11, Истина);
	Стр = Стр + 1;

	Колонки = СтрРазделить("№|Номенклатура|Артикул|Ед.|Количество|Сумма, руб.|Последнее поступление|Последний расход|Дней без продаж|Срок|Доля, %", "|");
	Если НесколькоОрганизаций Тогда
		Колонки.Добавить("Организация");
	КонецЕсли;
	ВывестиШапку(ТД, Стр, 1, Колонки);
	СтрокаШапки = Стр;
	Стр = Стр + 1;
	Номер = 0;
	Для Каждого Строка Из Залежавшиеся Цикл
		Номер = Номер + 1;
		Цвет = Сроки()[Строка.ИндексСрока].Цвет;
		ВывестиЯчейку(ТД, Стр, 1, Номер, "ЧГ=");
		ВывестиЯчейку(ТД, Стр, 2, Строка.Номенклатура, , , , Строка.Номенклатура);
		ВывестиЯчейку(ТД, Стр, 3, Строка.Артикул);
		ВывестиЯчейку(ТД, Стр, 4, Строка.ЕдиницаИзмерения);
		ВывестиЯчейку(ТД, Стр, 5, Строка.Количество, "ЧДЦ=3; ЧН=0");
		ВывестиЯчейку(ТД, Стр, 6, Строка.Сумма, "ЧДЦ=2; ЧН=0,00");
		ВывестиЯчейку(ТД, Стр, 7, ПредставлениеДаты(Строка.ПоследнийПриход, "нет"));
		ВывестиЯчейку(ТД, Стр, 8, ПредставлениеДаты(Строка.ПоследнийРасход, "не было"));
		ВывестиЯчейку(ТД, Стр, 9, ?(Строка.ДнейБезПродаж = Неопределено, "—", Строка.ДнейБезПродаж), "ЧГ=", Цвет, Истина);
		ВывестиЯчейку(ТД, Стр, 10, Строка.Срок, , Цвет);
		ВывестиЯчейку(ТД, Стр, 11, Доля(Строка.Сумма, ВсегоСумма), "ЧДЦ=1; ЧН=0,0");
		Если НесколькоОрганизаций Тогда
			ВывестиЯчейку(ТД, Стр, 12, Строка.Организация);
		КонецЕсли;
		Стр = Стр + 1;
	КонецЦикла;
	Если Номер = 0 Тогда
		ВывестиТекст(ТД, Стр, 2, "Таких товаров нет.", 10, Ложь, ЦветСерый());
		Стр = Стр + 1;
	Иначе
		ВывестиЯчейку(ТД, Стр, 2, "Итого", , , Истина);
		ВывестиЯчейку(ТД, Стр, 6, СуммаЗалежавшихся, "ЧДЦ=2; ЧН=0,00", , Истина);
		ВывестиЯчейку(ТД, Стр, 11, Доля(СуммаЗалежавшихся, ВсегоСумма), "ЧДЦ=1; ЧН=0,0", , Истина);
		Стр = Стр + 1;
	КонецЕсли;
	Стр = Стр + 1;

	// ---------- Отрицательные остатки ----------
	Если Параметры.ПоказыватьОтрицательные И Отрицательные.Количество() > 0 Тогда
		Отрицательные.Сортировать("Сумма Возр");
		СуммаОтрицательных = Отрицательные.Итог("Сумма");
		ВывестиТекст(ТД, Стр, 2, СтрШаблон("Отрицательные остатки — проверить учёт: %1 поз.%2", Отрицательные.Количество(),
			?(СуммаОтрицательных = 0, "", " на " + Формат(СуммаОтрицательных, "ЧДЦ=2") + " руб.")), 11, Истина, ЦветКрасный());
		Стр = Стр + 1;
		ВывестиТекст(ТД, Стр, 2, "Товар продан или списан, а поступление не отражено (или отражено позже). Себестоимость таких продаж занижена.",
			9, Ложь, ЦветСерый());
		Стр = Стр + 1;
		Колонки = СтрРазделить("№|Номенклатура|Артикул|Ед.|Количество|Сумма, руб.|Последнее поступление|Последний расход", "|");
		Если НесколькоОрганизаций Тогда
			Колонки.Добавить("Организация");
		КонецЕсли;
		ВывестиШапку(ТД, Стр, 1, Колонки);
		Стр = Стр + 1;
		Номер = 0;
		Для Каждого Строка Из Отрицательные Цикл
			Номер = Номер + 1;
			ВывестиЯчейку(ТД, Стр, 1, Номер, "ЧГ=");
			ВывестиЯчейку(ТД, Стр, 2, Строка.Номенклатура, , , , Строка.Номенклатура);
			ВывестиЯчейку(ТД, Стр, 3, Строка.Артикул);
			ВывестиЯчейку(ТД, Стр, 4, Строка.ЕдиницаИзмерения);
			ВывестиЯчейку(ТД, Стр, 5, Строка.Количество, "ЧДЦ=3; ЧН=0");
			ВывестиЯчейку(ТД, Стр, 6, Строка.Сумма, "ЧДЦ=2; ЧН=0,00");
			ВывестиЯчейку(ТД, Стр, 7, ПредставлениеДаты(Строка.ПоследнийПриход, "нет"));
			ВывестиЯчейку(ТД, Стр, 8, ПредставлениеДаты(Строка.ПоследнийРасход, "нет"));
			Если НесколькоОрганизаций Тогда
				ВывестиЯчейку(ТД, Стр, 9, Строка.Организация);
			КонецЕсли;
			Стр = Стр + 1;
		КонецЦикла;
	КонецЕсли;

	// ширины колонок
	Ширины = СтрРазделить("5|45|14|6|11|14|13|13|10|14|8|25", "|");
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		ТД.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = Число(Ширины[Индекс]);
	КонецЦикла;
	ТД.ПовторятьПриПечатиСтроки = ТД.Область(СтрокаШапки, , СтрокаШапки);

	Возврат ТД;

КонецФункции

// Описание групп по сроку: Индекс, Имя, Цвет. Индекс 0 — движений по товару в базе нет (остаток введён вводом остатков).
Функция Сроки() Экспорт

	Результат = Новый Массив;
	ДобавитьСрок(Результат, "нет движений в базе", Новый Цвет(217, 217, 217));
	ДобавитьСрок(Результат, "до 3 мес.", Новый Цвет(226, 239, 218));
	ДобавитьСрок(Результат, "3–6 мес.", Новый Цвет(255, 242, 204));
	ДобавитьСрок(Результат, "6–12 мес.", Новый Цвет(252, 213, 180));
	ДобавитьСрок(Результат, "1–2 года", Новый Цвет(248, 180, 170));
	ДобавитьСрок(Результат, "больше 2 лет", Новый Цвет(235, 140, 130));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДополнитьПараметры(Параметры)

	Результат = НовыеПараметры();
	Если Параметры <> Неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Если КлючЗначение.Значение <> Неопределено Тогда
				Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.Дата) Тогда
		Результат.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Результат.ПорогДней = Макс(0, Результат.ПорогДней);
	Возврат Результат;

КонецФункции

Функция ТекстЗапроса()

	Возврат
	"ВЫБРАТЬ
	|	Д.Организация КАК Организация,
	|	Д.СубконтоДт1 КАК Номенклатура,
	|	МАКСИМУМ(Д.Период) КАК ПоследнийПриход,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ПоследнийРасход
	|ПОМЕСТИТЬ ВТДвижения
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	|			,
	|			&КонецПериода,
	|			СчетДт В ИЕРАРХИИ (&СчетТовары)
	|				И НЕ СчетКт В ИЕРАРХИИ (&СчетТовары)
	|				И (&ВсеОрганизации
	|					ИЛИ Организация = &Организация),
	|			,
	|			) КАК Д
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Организация,
	|	Д.СубконтоДт1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Д.Организация,
	|	Д.СубконтоКт1,
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	МАКСИМУМ(Д.Период)
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	|			,
	|			&КонецПериода,
	|			СчетКт В ИЕРАРХИИ (&СчетТовары)
	|				И НЕ СчетДт В ИЕРАРХИИ (&СчетТовары)
	|				И (&ВсеОрганизации
	|					ИЛИ Организация = &Организация),
	|			,
	|			) КАК Д
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Организация,
	|	Д.СубконтоКт1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д.Организация КАК Организация,
	|	Д.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Д.ПоследнийПриход) КАК ПоследнийПриход,
	|	МАКСИМУМ(Д.ПоследнийРасход) КАК ПоследнийРасход
	|ПОМЕСТИТЬ ВТПоследние
	|ИЗ
	|	ВТДвижения КАК Д
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Организация,
	|	Д.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ост.Организация КАК Организация,
	|	Ост.Субконто1 КАК Номенклатура,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество,
	|	СУММА(Ост.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Граница,
	|			Счет В ИЕРАРХИИ (&СчетТовары),
	|			,
	|			&ВсеОрганизации
	|				ИЛИ Организация = &Организация) КАК Ост
	|ГДЕ
	|	(&ВсяНоменклатура
	|			ИЛИ Ост.Субконто1 В ИЕРАРХИИ (&Группа))
	|
	|СГРУППИРОВАТЬ ПО
	|	Ост.Организация,
	|	Ост.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ост.Организация КАК Организация,
	|	Ост.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.Номенклатура КАК Справочник.Номенклатура).Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(Ост.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(Ост.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(Посл.ПоследнийПриход, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследнийПриход,
	|	ЕСТЬNULL(Посл.ПоследнийРасход, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследнийРасход
	|ИЗ
	|	ВТОстатки КАК Ост
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоследние КАК Посл
	|		ПО Ост.Организация = Посл.Организация
	|			И Ост.Номенклатура = Посл.Номенклатура
	|ГДЕ
	|	(ЕСТЬNULL(Ост.Количество, 0) <> 0
	|			ИЛИ ЕСТЬNULL(Ост.Сумма, 0) <> 0)";

КонецФункции

Функция ИндексСрока(Дней)

	Если Дней = Неопределено Тогда
		Возврат 0;
	ИначеЕсли Дней <= 90 Тогда
		Возврат 1;
	ИначеЕсли Дней <= 180 Тогда
		Возврат 2;
	ИначеЕсли Дней <= 365 Тогда
		Возврат 3;
	ИначеЕсли Дней <= 730 Тогда
		Возврат 4;
	КонецЕсли;
	Возврат 5;

КонецФункции

Процедура ДобавитьСрок(Массив, Имя, Цвет)
	Массив.Добавить(Новый Структура("Индекс, Имя, Цвет", Массив.Количество(), Имя, Цвет));
КонецПроцедуры

Функция Доля(Часть, Целое)
	Возврат ?(Целое = 0, 0, Окр(Часть / Целое * 100, 1));
КонецФункции

Функция ПредставлениеДаты(Значение, ЕслиПусто)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=dd.MM.yyyy"), ЕслиПусто);
КонецФункции

Функция ЦветСерый()
	Возврат Новый Цвет(110, 110, 110);
КонецФункции

Функция ЦветКрасный()
	Возврат Новый Цвет(192, 0, 0);
КонецФункции

Процедура ВывестиТекст(ТД, Стр, Кол, Текст, Размер, Жирный, ЦветТекста = Неопределено)

	Обл = ТД.Область(Стр, Кол, Стр, Кол);
	Обл.Текст = Текст;
	Обл.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Если ЦветТекста <> Неопределено Тогда
		Обл.ЦветТекста = ЦветТекста;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиШапку(ТД, Стр, ПерваяКолонка, Заголовки)

	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Обл = ТД.Область(Стр, ПерваяКолонка + Индекс, Стр, ПерваяКолонка + Индекс);
		Обл.Текст = Заголовки[Индекс];
		Обл.Шрифт = Новый Шрифт("Arial", 9, Истина);
		Обл.ЦветФона = Новый Цвет(242, 242, 242);
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Обвести(Обл);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиЯчейку(ТД, Стр, Кол, Значение, ФорматЧисла = "", ЦветФона = Неопределено, Жирный = Ложь, Расшифровка = Неопределено)

	Обл = ТД.Область(Стр, Кол, Стр, Кол);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Обл.Текст = Формат(Значение, ФорматЧисла);
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Иначе
		Обл.Текст = Строка(Значение);
	КонецЕсли;
	Обл.Шрифт = Новый Шрифт("Arial", 9, Жирный);
	Если ЦветФона <> Неопределено Тогда
		Обл.ЦветФона = ЦветФона;
	КонецЕсли;
	Если Расшифровка <> Неопределено Тогда
		Обл.Расшифровка = Расшифровка;
	КонецЕсли;
	Обвести(Обл);

КонецПроцедуры

Процедура Обвести(Обл)
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Обл.Обвести(Линия, Линия, Линия, Линия);
	Обл.ЦветРамки = Новый Цвет(191, 191, 191);
КонецПроцедуры

#КонецОбласти
